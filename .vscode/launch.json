{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Screen Emulator",
            "type": "debugpy",
            "request": "launch",
            "program": "python/usart_sprite_display.py",
            "console": "integratedTerminal"
        },
        {
            "type": "stlinkgdbtarget",
            "request": "launch",
            "name": "STM32Cube: Launch ST-Link GDB Server",
            "origin": "snippet",
            "cwd": "${workspaceFolder}",
            "preBuild": "${command:st-stm32-ide-debug-launch.build}",
            "runEntry": "main",
            "serverSerialNumber": "${input:stlinkSerial}",
            "imagesAndSymbols": [
                {
                    "imageFileName": "${command:st-stm32-ide-debug-launch.get-projects-binary-from-context1}"
                }
            ]
        },
        {
            "name": "Cortex Debug",
            "cwd": "${workspaceFolder}",
            "executable": ".\\build\\Debug\\TetrisHandheld.elf",
            "request": "launch",
            "type": "cortex-debug",
            "runToEntryPoint": "main",
            "servertype": "stlink"
        }
    ],
    "inputs": [
        {
            // ST-Link serial numbers (USB\VID_0483&PID_374B\<serial>), labelled by their Virtual COM port
            "id": "stlinkSerial",
            "type": "pickString",
            "description": "Select which ST-Link / board to debug",
            "options": [
                {
                    "label": "P1",
                    "value": "066BFF514988525067213214"
                },
                {
                    "label": "P2",
                    "value": "066CFF514988525067221235"
                }
            ],
            "default": "066BFF514988525067213214"
        }
    ]
}